{
    "manifest_version": 3,
    "name": "Steganalysis Detector",
    "version": "1.0",
    "description": "Hide, detect, and reveal hidden messages in images, videos, and audio files with drag-and-drop from web pages",
    "permissions": [
        "activeTab",
        "storage",
        "scripting",
        "contextMenus",
        "notifications",
        "sidePanel"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "side_panel": {
        "default_path": "side_panel.html"
    },
    "host_permissions": [
        "http://localhost:5000/*",
        "https://*/*",
        "http://*/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ]
}